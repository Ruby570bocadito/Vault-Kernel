# vault_kernel gitignore
# Build artifacts
*.o
*.ko
*.mod
!go.mod
*.mod.c
*.mod.o
*.order
*.symvers
.*.cmd
*.tmp_versions/
modules.order
Module.symvers

# Editor
*.swp
*.swo
*~

# Python
__pycache__/
*.pyc
# Ruff's cache self-excludes via its own .gitignore; this line keeps the
# intent explicit even if that file is removed or the cache is recreated.
.ruff_cache/

# IDE
.vscode/
.idea/

# Go binaries
client/go/vault_kernel

# Docker build output
docker/out/

# Generated payloads (payloads/payload.py output)
*_stager_*
payloads/*.sh
payloads/*.py
payloads/*.c
!payloads/payload.py
!payloads/builder.sh

# Local build/test scratch
*.log
.venv/
